# ── Anthropic Claude API (required for NLP parsing) ──────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model used for NLP entity extraction
CLAUDE_MODEL=claude-sonnet-4-6

# ── Embedding provider ────────────────────────────────────────────────────────
# Local sentence-transformers model (free, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Service URLs & ports ──────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
NODE_PORT=3000
ML_SERVICE_PORT=8000

# ── Retrieval parameters ──────────────────────────────────────────────────────
# Number of nearest neighbours to retrieve from FAISS
FAISS_K=10
# Weight for blending kNN win-rate vs ML model probability (0 = kNN only, 1 = model only)
PROBABILITY_BLEND_WEIGHT=0.5
